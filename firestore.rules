rules_version = '2';

// Access model
// ------------
// Credentials live in Firebase Auth; `users/{uid}` holds the profile that grants
// a role. A signed-in account with no profile document therefore has no access
// at all — that is how removing someone from the Team page revokes them without
// deleting their Auth record.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // get() inside rules bypasses rules, so this can't recurse.
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return hasProfile() && profile().role == 'admin';
    }

    function isManager() {
      return hasProfile() && profile().role == 'social-media-manager';
    }

    function isAssigned(clientId) {
      return hasProfile() && profile().assignedClientIds.hasAny([clientId]);
    }

    function onlyDecisionFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['decision', 'decisionNote', 'decidedAt']);
    }

    function onlyReviewFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['clientReview', 'reviewNote']);
    }

    match /users/{userId} {
      // You can always read your own profile — this is the lookup that resolves
      // your role at sign-in, so it must not depend on the helpers above.
      allow get: if signedIn() && request.auth.uid == userId;
      allow read: if isAdmin();

      // Admin-only writes are what prevent a user from promoting themselves.
      allow create, update, delete: if isAdmin();
    }

    match /clients/{clientId} {
      allow read: if isAdmin() || isManager() || isAssigned(clientId);
      // Clients no longer write here at all — their review decisions live on
      // the individual content documents below.
      allow create, update, delete: if isAdmin() || isManager();

      match /content/{contentId} {
        // clientId is fixed by the path and this rule doesn't depend on
        // contentId, so an assigned client can run a normal list query here —
        // unlike the top-level clients collection.
        allow read: if isAdmin() || isManager() || isAssigned(clientId);
        allow create, delete: if isAdmin() || isManager();

        // A client may record a review decision and nothing else. This is the
        // per-item restriction that an array field could not express.
        allow update: if isAdmin() || isManager()
          || (isAssigned(clientId) && onlyReviewFieldsChanged());

        // Anyone who can see the item can discuss it, including clients.
        // Comments are append-only: nobody edits or deletes history except an
        // admin, so the activity trail can be trusted.
        match /comments/{commentId} {
          allow read, create: if isAdmin() || isManager() || isAssigned(clientId);
          allow update: if false;
          allow delete: if isAdmin();
        }
      }

      // Clients submit ideas; only the team triages them.
      match /ideas/{ideaId} {
        allow read, create: if isAdmin() || isManager() || isAssigned(clientId);
        allow update, delete: if isAdmin() || isManager();

        match /comments/{commentId} {
          allow read, create: if isAdmin() || isManager() || isAssigned(clientId);
          allow update: if false;
          allow delete: if isAdmin();
        }
      }
    }

    // Public review links. The document ID is an unguessable token and holding
    // it is the entire credential, so these carry a snapshot of one item rather
    // than granting access to the content collection.
    match /shares/{token} {
      // `get` only, never `list` — the collection must not be enumerable, or
      // the tokens would be pointless.
      allow get: if resource.data.revoked == false;
      allow list: if isAdmin() || isManager();

      allow create: if isAdmin() || isManager();
      allow delete: if isAdmin() || isManager();

      // An anonymous reviewer may record a decision and nothing else, and only
      // while the link is live.
      allow update: if isAdmin() || isManager()
        || (resource.data.revoked == false && onlyDecisionFieldsChanged());
    }

    // Everything else stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
